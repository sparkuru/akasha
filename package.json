{
  "name": "akasha",
  "version": "0.1.0",
  "type": "module",
  "description": "Akasha — a vendor-clean object-storage browsing system (the Void System).",
  "module": "src/index.ts",
  "bin": {
    "akasha": "src/cli/terminal.ts"
  },
  "scripts": {
    "akasha": "bun run src/cli/terminal.ts",
    "dev": "bun run src/server/app.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "elysia": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
