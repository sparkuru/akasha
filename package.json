{
  "name": "akasha",
  "version": "0.1.0",
  "type": "module",
  "description": "Akasha — a vendor-clean object-storage browsing system (the Void System).",
  "module": "src/index.ts",
  "bin": {
    "akasha": "src/cli/terminal.ts"
  },
  "scripts": {
    "akasha": "bun run src/cli/terminal.ts",
    "dev": "bun run src/server/app.ts",
    "build:web": "bun build ./src/frontend/main.ts --outdir src/frontend/dist --minify --target browser",
    "dev:web": "bun build ./src/frontend/main.ts --outdir src/frontend/dist --watch --target browser",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@elysiajs/eden": "^1.4",
    "@elysiajs/openapi": "^1.4",
    "citty": "^0.1.6",
    "elysia": "^1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@happy-dom/global-registrator": "^20.10.2",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
